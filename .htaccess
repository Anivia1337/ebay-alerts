# /ebay - Oberflaeche fuer den eBay-Discord-Bot. bot.php laeuft nur per Cron (CLI).
Options -Indexes

# Wie /deals: ohne das leitet mod_dir hinter dem Proxy auf http:// um.
DirectorySlash Off
DirectoryIndex index.php

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set Content-Security-Policy "default-src 'none'; style-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
</IfModule>
